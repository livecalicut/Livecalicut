# ================================================
# LiveCalicut — Environment Variables
# ================================================
# NEXT_PUBLIC_* vars are safe for the browser.
# Never put secrets here — use .env.local for those.
#
# ⚠️  REQUIRED: Replace with your real Supabase credentials
# Get them from: https://supabase.com/dashboard → Project Settings → API
# ================================================

# Supabase Project (PUBLIC — embedded in client bundle)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_REAL_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://kbwxkoceqbgzaqfzfboq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtid3hrb2NlcWJnemFxZnpmYm9xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ3MjkwNDcsImV4cCI6MjEwMDMwNTA0N30.lYqiKhUQHhZWmhxqfwc-sWuHf1VJUcHkHCDHBjlTEKc

# App Identity (PUBLIC)
