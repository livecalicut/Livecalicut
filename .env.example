# ================================================
# LiveCalicut — Environment Variables
# Copy to .env (and optionally .env.local for secrets)
# ================================================

# Supabase (PUBLIC)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (SECRET — server only, never NEXT_PUBLIC_)
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Identity (PUBLIC)
NEXT_PUBLIC_APP_NAME=LiveCalicut Hyperlocal Portal
NEXT_PUBLIC_APP_DEFAULT_CITY=Kozhikode (Calicut)
NEXT_PUBLIC_APP_DEFAULT_LAT=11.2588
NEXT_PUBLIC_APP_DEFAULT_LNG=75.7804
NEXT_PUBLIC_ENABLE_MARKETPLACE=true
NEXT_PUBLIC_ENABLE_JOBS=true
NEXT_PUBLIC_ENABLE_REALTIME=true
